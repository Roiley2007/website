{"version":1,"seed":20260904,"rngState":1455443026,"tick":344,"startedAt":"2026-09-04T19:08:56.369Z","lastTickAt":"2026-09-05T00:56:34.360Z","worldMinutes":2080,"weather":"rain","weatherUntil":358,"nextPrayerId":1,"agents":[{"id":"bram","pos":{"x":25,"y":19},"prev":{"x":25,"y":19},"path":[],"action":{"kind":"drink","thoughtKey":"drink","phase":"travel","dest":{"x":23,"y":17},"remaining":3,"meta":{}},"needs":{"hunger":85.00000000000085,"thirst":72.69999999999989,"energy":50.54999999999977,"social":80.66600000000079,"comfort":57.72308424531969,"spirit":47.760000000000026},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"Neth planting the hedge along the east path, laughing at how crooked it went. It is still crooked.","kind":"love","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"The winter fever. The sound the house made afterwards, which was nothing.","kind":"grief","weight":10,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"Wren on the road out, not looking back. I did not call after her. I should have.","kind":"regret","weight":9,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Forty-one harvests. The good ones blur together. The bad ones I can name.","kind":"work","weight":5,"seed":true,"i":3},{"tick":306,"day":2,"time":"07:30","text":"Turned the east rows. The soil is behaving.","kind":"work","weight":3},{"tick":344,"day":2,"time":"10:40","text":"Sat with Odile. Comfortable quiet, mostly.","kind":"company","weight":4}],"relationships":{"odile":52.00000000000003,"tam":47.45000000000001},"pressure":{"wren":14.26626629146544,"plough":10.142186186237193,"rain":10.1239664719827},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"On the path.","stats":{"prayers":0,"answered":0,"meals":2,"nights":2,"shifts":6,"conversations":3}},{"id":"odile","pos":{"x":23,"y":17},"prev":{"x":23,"y":17},"path":[],"action":{"kind":"work","thoughtKey":"work_well","phase":"do","dest":{"x":23,"y":17},"remaining":23,"meta":{}},"needs":{"hunger":84.70000000000014,"thirst":74.7999999999999,"energy":59.38999999999976,"social":56.91600000000072,"comfort":60.044060666549704,"spirit":53.50999999999974},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"The inside of the cart. Straw, and a red blanket, and being told not to look out.","kind":"origin","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Old Marrow teaching me which fever-leaf is which by making me chew the wrong one first.","kind":"learning","weight":7,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"The year the well went brackish and I fixed it, and nobody noticed, which is how you know it worked.","kind":"work","weight":6,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Ledger, page one: \"Things I do not know.\" It is the longest page.","kind":"origin","weight":8,"seed":true,"i":3},{"tick":132,"day":1,"time":"17:00","text":"Cleared the well and wrote the water level in the ledger.","kind":"work","weight":3},{"tick":318,"day":2,"time":"08:30","text":"Waited at the square a while. Nobody came by.","kind":"loneliness","weight":5}],"relationships":{"bram":47.45000000000001,"tam":46.75000000000001},"pressure":{"origin":8.002729173605507,"books":6.739140356720426,"lantern":4.0307636836412755},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Tending the well.","stats":{"prayers":0,"answered":0,"meals":3,"nights":3,"shifts":5,"conversations":1}},{"id":"tam","pos":{"x":41,"y":26},"prev":{"x":41,"y":26},"path":[],"action":{"kind":"work","thoughtKey":"work_woods","phase":"do","dest":{"x":42,"y":27},"remaining":4,"meta":{}},"needs":{"hunger":83.80000000000015,"thirst":72.69999999999989,"energy":52.26999999999977,"social":62.81600000000077,"comfort":61.08358947870984,"spirit":45.620000000000026},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"The river at night. I was four. I remember being carried away from the bank, not toward it.","kind":"grief","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Eating at a different house every night for six years. Everyone was kind. Nobody was mine.","kind":"origin","weight":9,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"The water-wheel turning for the first time. It ran eight days. Best eight days.","kind":"joy","weight":8,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Bram let me sharpen his scythe once and said it was \"not bad\". I think about that a lot.","kind":"joy","weight":6,"seed":true,"i":3},{"tick":42,"day":1,"time":"09:30","text":"The axe head is loose again. Wedged it with a shim. It will hold or it will not.","kind":"work","weight":3},{"tick":152,"day":1,"time":"18:40","text":"Woke before dawn, listened to the rain, went back under.","kind":"rest","weight":3},{"tick":173,"day":1,"time":"20:25","text":"Spoke with Odile at the square. News, weather, nothing.","kind":"company","weight":4}],"relationships":{"bram":47.80000000000001,"odile":49.20000000000002},"pressure":{"tools":13.334497972794365,"bridge":18.56918540172417,"company":14.927615533448225},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Splitting logs badly but fast.","stats":{"prayers":0,"answered":0,"meals":3,"nights":2,"shifts":4,"conversations":2}}],"houses":{"house_bram":{"larder":18,"warmth":78.48625000000088,"repair":82.59199999999828},"house_odile":{"larder":12,"warmth":78.93625000000081,"repair":82.59199999999828},"house_tam":{"larder":12,"warmth":78.48625000000087,"repair":91.59199999999828}},"village":{"granary":199.60000000000082,"fieldYield":25.808500000000397,"wellWater":100,"firewood":44.65999999999955},"structures":[],"events":[{"tick":120,"day":1,"time":"16:00","text":"The weather turned to rain."}]}

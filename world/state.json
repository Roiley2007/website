{"version":1,"seed":20260904,"rngState":-353393887,"tick":308,"startedAt":"2026-09-04T19:08:56.369Z","lastTickAt":"2026-09-05T00:20:15.775Z","worldMinutes":1900,"weather":"rain","weatherUntil":358,"nextPrayerId":1,"agents":[{"id":"bram","pos":{"x":23,"y":6},"prev":{"x":23,"y":6},"path":[],"action":{"kind":"work","thoughtKey":"work_field","phase":"do","dest":{"x":23,"y":6},"remaining":22,"meta":{}},"needs":{"hunger":90.30000000000075,"thirst":87.81999999999995,"energy":70.5099999999998,"social":62.42600000000063,"comfort":63.57308424531974,"spirit":45.48000000000001},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"Neth planting the hedge along the east path, laughing at how crooked it went. It is still crooked.","kind":"love","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"The winter fever. The sound the house made afterwards, which was nothing.","kind":"grief","weight":10,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"Wren on the road out, not looking back. I did not call after her. I should have.","kind":"regret","weight":9,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Forty-one harvests. The good ones blur together. The bad ones I can name.","kind":"work","weight":5,"seed":true,"i":3},{"tick":306,"day":2,"time":"07:30","text":"Turned the east rows. The soil is behaving.","kind":"work","weight":3}],"relationships":{"odile":48.500000000000014,"tam":47.45000000000001},"pressure":{"wren":11.766465615413734,"plough":8.455927518819818,"rain":8.550817308189613},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Bent over the furrows.","stats":{"prayers":0,"answered":0,"meals":2,"nights":2,"shifts":5,"conversations":2}},{"id":"odile","pos":{"x":25,"y":19},"prev":{"x":25,"y":19},"path":[],"action":{"kind":"socialise","thoughtKey":"socialise","phase":"travel","dest":{"x":25,"y":19},"remaining":10,"meta":{}},"needs":{"hunger":95.50000000000004,"thirst":89.91999999999996,"energy":80.00999999999979,"social":59.176000000000585,"comfort":65.89406066654968,"spirit":51.17999999999977},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"The inside of the cart. Straw, and a red blanket, and being told not to look out.","kind":"origin","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Old Marrow teaching me which fever-leaf is which by making me chew the wrong one first.","kind":"learning","weight":7,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"The year the well went brackish and I fixed it, and nobody noticed, which is how you know it worked.","kind":"work","weight":6,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Ledger, page one: \"Things I do not know.\" It is the longest page.","kind":"origin","weight":8,"seed":true,"i":3},{"tick":132,"day":1,"time":"17:00","text":"Cleared the well and wrote the water level in the ledger.","kind":"work","weight":3}],"relationships":{"bram":47.45000000000001,"tam":46.75000000000001},"pressure":{"origin":6.599801602183037,"books":5.557727664996239,"lantern":3.3474196871112696},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Heading over.","stats":{"prayers":0,"answered":0,"meals":3,"nights":3,"shifts":4,"conversations":1}},{"id":"tam","pos":{"x":41,"y":26},"prev":{"x":41,"y":26},"path":[],"action":{"kind":"work","thoughtKey":"work_woods","phase":"do","dest":{"x":42,"y":27},"remaining":16,"meta":{}},"needs":{"hunger":94.60000000000005,"thirst":87.81999999999995,"energy":75.30999999999979,"social":68.57600000000065,"comfort":66.93358947870976,"spirit":44.539999999999985},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"The river at night. I was four. I remember being carried away from the bank, not toward it.","kind":"grief","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Eating at a different house every night
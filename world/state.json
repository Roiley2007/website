-1,"day":0,"time":"before","text":"The inside of the cart. Straw, and a red blanket, and being told not to look out.","kind":"origin","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Old Marrow teaching me which fever-leaf is which by making me chew the wrong one first.","kind":"learning","weight":7,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"The year the well went brackish and I fixed it, and nobody noticed, which is how you know it worked.","kind":"work","weight":6,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Ledger, page one: \"Things I do not know.\" It is the longest page.","kind":"origin","weight":8,"seed":true,"i":3},{"tick":132,"day":1,"time":"17:00","text":"Cleared the well and wrote the water level in the ledger.","kind":"work","weight":3}],"relationships":{"bram":47.45000000000001,"tam":46.75000000000001},"pressure":{"origin":1.1688508446181465,"books":0.9842954480994915,"lantern":0.6362934302908206},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Exhausted.","stats":{"prayers":0,"answered":0,"meals":2,"nights":2,"shifts":4,"conversations":1}},{"id":"tam","pos":{"x":10,"y":27},"prev":{"x":10,"y":27},"path":[],"action":{"kind":"sleep","thoughtKey":"sleep","phase":"do","dest":{"x":10,"y":27},"remaining":1,"meta":{}},"needs":{"hunger":92.20000000000007,"thirst":84.03999999999994,"energy":2.1,"social":78.99200000000067,"comfort":44.36422754629965,"spirit":49.15999999999996},"inventory":[],"memories":[{"tick":-1,"day":0,"time":"before","text":"The river at night. I was four. I remember being carried away from the bank, not toward it.","kind":"grief","weight":10,"seed":true,"i":0},{"tick":-1,"day":0,"time":"before","text":"Eating at a different house every night for six years. Everyone was kind. Nobody was mine.","kind":"origin","weight":9,"seed":true,"i":1},{"tick":-1,"day":0,"time":"before","text":"The water-wheel turning for the first time. It ran eight days. Best eight days.","kind":"joy","weight":8,"seed":true,"i":2},{"tick":-1,"day":0,"time":"before","text":"Bram let me sharpen his scythe once and said it was \"not bad\". I think about that a lot.","kind":"joy","weight":6,"seed":true,"i":3},{"tick":42,"day":1,"time":"09:30","text":"The axe head is loose again. Wedged it with a shim. It will hold or it will not.","kind":"work","weight":3},{"tick":152,"day":1,"time":"18:40","text":"Woke before dawn, listened to the rain, went back under.","kind":"rest","weight":3},{"tick":173,"day":1,"time":"20:25","text":"Spoke with Odile at the square. News, weather, nothing.","kind":"company","weight":4}],"relationships":{"bram":47.80000000000001,"odile":49.20000000000002},"pressure":{"tools":4.167055265081297,"bridge":5.336701915732747,"company":4.641538039448248},"prayedFor":{},"prayerCounts":{},"answeredCounts":{},"pendingDesire":null,"openPrayers":[],"thought":"Exhausted.","stats":{"prayers":0,"answered":0,"meals":2,"nights":1,"shifts":3,"conversations":2}}],"houses":{"house_bram":{"larder":24,"warmth":51.37374999999996,"repair":83.72599999999909},"house_odile":{"larder":18,"warmth":50.02374999999995,"repair":83.72599999999909},"house_tam":{"larder":18,"warmth":50.47374999999995,"repair":92.72599999999909}},"village":{"granary":156.40000000000055,"fieldYield":18.221500000000443,"wellWater":100,"firewood":54.919999999999945},"structures":[],"events":[{"tick":120,"day":1,"time":"16:00","text":"The weather turned to rain."}]}
